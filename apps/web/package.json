    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.14",
    "vite": "^7.1.9",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.1.0"

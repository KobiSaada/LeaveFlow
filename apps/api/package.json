{
  "name": "@leaveflow/api",
  "version": "1.0.0",
  "private": true,
  "description": "LeaveFlow API — Node.js on commoneventframework (Lambda-shaped), TypeORM, PostgreSQL",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts --local 3000",
    "start": "tsx src/index.ts --local 3000",
    "build": "cef-build",
    "codegen": "cef-gen-handlers",
    "codegen:check": "node scripts/codegen-check.js",
    "db:migrate": "tsx scripts/migrate.ts up",
    "db:migrate:revert": "tsx scripts/migrate.ts down",
    "db:seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@leaveflow/contracts": "1.0.0",
    "bcryptjs": "^3.0.2",
    "commoneventframework": "1.0.19",
    "dotenv": "^16.6.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "pino": "^9.13.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.27",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.155",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.0",
    "pino-pretty": "^13.1.1",
    "tsx": "^4.20.6",
    "vitest": "^4.1.11"
  }
}

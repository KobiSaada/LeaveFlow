# Loaded by CEF's loadEnv() from the API working directory (apps/api).
NODE_ENV=development

# PostgreSQL (docker compose maps the container to host port 5544)
DATABASE_URL=postgres://leaveflow:leaveflow@localhost:5544/leaveflow
TEST_DATABASE_URL=postgres://leaveflow:leaveflow@localhost:5544/leaveflow_test

# JWT — HS256. The secret must be at least 32 characters; change it outside local development.
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef
JWT_ISSUER=leaveflow-api
JWT_AUDIENCE=leaveflow-web
JWT_TTL_SECONDS=28800

# "Today" for the no-past-dates rule is evaluated in this IANA time zone.
BUSINESS_TIMEZONE=Asia/Jerusalem

# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
